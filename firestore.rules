rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions & Hierarchical RBAC Gates
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isInitialOwnerEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'alssaedy500@gmail.com' || request.auth.token.email == 'alssaedy50@gmail.com');
    }

    function hasRoleDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    function getRoleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    function isPlatformOwner() {
      return isAuthenticated() && (
        isInitialOwnerEmail() ||
        (hasRoleDoc() && getRoleDoc().data.role == 'platform_owner')
      );
    }

    function isUniversityAdmin(universityId) {
      return isAuthenticated() && (
        isPlatformOwner() ||
        (hasRoleDoc() &&
         getRoleDoc().data.role == 'university_admin' &&
         (universityId == null || getRoleDoc().data.assignedUniversityId == universityId))
      );
    }

    function isBatchRep(universityId, studyLevelId) {
      return isAuthenticated() && (
        isUniversityAdmin(universityId) ||
        (hasRoleDoc() &&
         getRoleDoc().data.role == 'batch_rep' &&
         (universityId == null || getRoleDoc().data.assignedUniversityId == universityId) &&
         (studyLevelId == null || getRoleDoc().data.assignedStudyLevelId == studyLevelId))
      );
    }

    function isDepartmentHead(universityId, studyLevelId) {
      return isAuthenticated() && (
        isBatchRep(universityId, studyLevelId) ||
        (hasRoleDoc() &&
         getRoleDoc().data.role == 'department_head' &&
         (universityId == null || getRoleDoc().data.assignedUniversityId == universityId) &&
         (studyLevelId == null || getRoleDoc().data.assignedStudyLevelId == studyLevelId))
      );
    }

    function isAnyAdmin() {
      return isAuthenticated() && (
        isPlatformOwner() ||
        (hasRoleDoc() &&
         (getRoleDoc().data.role == 'university_admin' ||
          getRoleDoc().data.role == 'batch_rep' ||
          getRoleDoc().data.role == 'department_head'))
      );
    }

    // Strict Hierarchical Promotion Gate: Prevents Horizontal/Vertical Privilege Escalation
    function canAssignUserRole(targetData) {
      return isPlatformOwner() ||
        (hasRoleDoc() &&
         getRoleDoc().data.role == 'university_admin' &&
         (targetData.role == 'batch_rep' || targetData.role == 'department_head' || targetData.role == 'student') &&
         targetData.assignedUniversityId == getRoleDoc().data.assignedUniversityId) ||
        (hasRoleDoc() &&
         getRoleDoc().data.role == 'batch_rep' &&
         (targetData.role == 'department_head' || targetData.role == 'student') &&
         targetData.assignedUniversityId == getRoleDoc().data.assignedUniversityId &&
         targetData.assignedStudyLevelId == getRoleDoc().data.assignedStudyLevelId);
    }

    // -------------------------------------------------------------------------
    // System Connectivity Probe
    // -------------------------------------------------------------------------
    match /system/{docId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // -------------------------------------------------------------------------
    // User Roles & Profiles (Hardened against Privilege Escalation)
    // -------------------------------------------------------------------------

    match /userRoles/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAnyAdmin());
      allow create, update: if (isOwner(uid) && isInitialOwnerEmail() && request.resource.data.role == 'platform_owner') ||
                               canAssignUserRole(request.resource.data);
      allow delete: if isPlatformOwner() ||
                       (hasRoleDoc() &&
                        getRoleDoc().data.role == 'university_admin' &&
                        resource.data.assignedUniversityId == getRoleDoc().data.assignedUniversityId &&
                        resource.data.role != 'platform_owner' &&
                        resource.data.role != 'university_admin') ||
                       (hasRoleDoc() &&
                        getRoleDoc().data.role == 'batch_rep' &&
                        resource.data.assignedUniversityId == getRoleDoc().data.assignedUniversityId &&
                        resource.data.assignedStudyLevelId == getRoleDoc().data.assignedStudyLevelId &&
                        resource.data.role == 'department_head');
    }

    match /userProfiles/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) || isAnyAdmin();
      allow delete: if isPlatformOwner();
    }

    // -------------------------------------------------------------------------
    // Academic Hierarchy (University & Batch Scoped)
    // -------------------------------------------------------------------------

    match /countries/{countryId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    match /universities/{universityId} {
      allow read: if true;
      allow create, delete: if isPlatformOwner();
      allow update: if isUniversityAdmin(universityId);
    }

    match /colleges/{collegeId} {
      allow read: if true;
      allow create, update: if isUniversityAdmin(request.resource.data.universityId);
      allow delete: if isUniversityAdmin(resource.data.universityId);
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update: if isUniversityAdmin(request.resource.data.universityId);
      allow delete: if isUniversityAdmin(resource.data.universityId);
    }

    match /curriculumVersions/{curriculumId} {
      allow read: if true;
      allow create, update: if isUniversityAdmin(request.resource.data.universityId);
      allow delete: if isUniversityAdmin(resource.data.universityId);
    }

    match /studyLevels/{levelId} {
      allow read: if true;
      allow create, update: if isUniversityAdmin(request.resource.data.universityId);
      allow delete: if isUniversityAdmin(resource.data.universityId);
    }

    match /studyPeriods/{periodId} {
      allow read: if true;
      allow create, update: if isBatchRep(request.resource.data.universityId, request.resource.data.studyLevelId);
      allow delete: if isBatchRep(resource.data.universityId, resource.data.studyLevelId);
    }

    match /courseOfferings/{courseId} {
      allow read: if true;
      allow create, update: if isDepartmentHead(request.resource.data.universityId, request.resource.data.studyLevelId);
      allow delete: if isBatchRep(resource.data.universityId, resource.data.studyLevelId);
    }

    // -------------------------------------------------------------------------
    // Course Instructors (Subject Doctors) & Batch Notifications
    // -------------------------------------------------------------------------

    match /courseInstructors/{instructorId} {
      allow read: if isAuthenticated();
      allow create, update: if isDepartmentHead(request.resource.data.universityId, request.resource.data.studyLevelId);
      allow delete: if isDepartmentHead(resource.data.universityId, resource.data.studyLevelId);
    }

    match /batchNotifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update: if isDepartmentHead(request.resource.data.universityId, request.resource.data.studyLevelId);
      allow delete: if isDepartmentHead(resource.data.universityId, resource.data.studyLevelId);
    }

    // -------------------------------------------------------------------------
    // Unique Identifiers Registry (Enforces 100% Unique Email, Phone, & Academic ID)
    // -------------------------------------------------------------------------

    match /uniqueIdentifiers/{identifierId} {
      allow get: if true;
      allow list: if isAnyAdmin();
      allow create, update: if isAuthenticated() &&
        (request.resource.data.uid == request.auth.uid || isAnyAdmin()) &&
        (!exists(/databases/$(database)/documents/uniqueIdentifiers/$(identifierId)) ||
         resource.data.uid == request.auth.uid ||
         isAnyAdmin());
      allow delete: if isAnyAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Account Verification Challenges (Email & Phone Verification Codes)
    // -------------------------------------------------------------------------

    match /verificationChallenges/{uid} {
      allow read, write: if isOwner(uid) || isPlatformOwner();
    }

    // -------------------------------------------------------------------------
    // Student Enrollments & Change Requests
    // -------------------------------------------------------------------------

    match /studentEnrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.uid == request.auth.uid) ||
                       isUniversityAdmin(request.resource.data.universityId);
      allow update: if isUniversityAdmin(resource.data.universityId) ||
                       (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isUniversityAdmin(resource.data.universityId);
    }

    match /academicChangeRequests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.uid == request.auth.uid || isUniversityAdmin(resource.data.universityId));
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isUniversityAdmin(resource.data.universityId);
    }

    // -------------------------------------------------------------------------
    // Educational Resources (Low-Bandwidth Materials)
    // -------------------------------------------------------------------------

    match /educationalResources/{resourceId} {
      allow read: if isAuthenticated() && 
        (resource.data.status == 'published' || isAnyAdmin());
      allow create, update: if isDepartmentHead(request.resource.data.universityId, request.resource.data.studyLevelId);
      allow delete: if isDepartmentHead(resource.data.universityId, resource.data.studyLevelId);
    }

    match /uploadedFileChunks/{chunkId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // -------------------------------------------------------------------------
    // Assessments, Questions & Protected Answer Keys
    // -------------------------------------------------------------------------

    match /questionBanks/{bankId} {
      allow read: if isAnyAdmin();
      allow create, update: if isDepartmentHead(request.resource.data.universityId, null);
      allow delete: if isDepartmentHead(resource.data.universityId, null);
    }

    // Admin Full Questions (includes answer keys - restricted to admins)
    match /questions/{questionId} {
      allow read, write: if isAnyAdmin();
    }

    // Public Question Stems & Options (NO Answer Keys - readable by authenticated students)
    match /assessmentQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // PROTECTED ANSWER KEYS: NEVER readable directly by students; restricted to admins
    match /questionAnswerKeys/{questionId} {
      allow read, write: if isAnyAdmin();
    }

    match /assessments/{assessmentId} {
      allow read: if isAuthenticated() && 
        (resource.data.status == 'published' || isAnyAdmin());
      allow create, update: if isDepartmentHead(request.resource.data.universityId, request.resource.data.studyLevelId);
      allow delete: if isDepartmentHead(resource.data.universityId, resource.data.studyLevelId);
    }

    // Assessment Attempts (Student Progressive Saving)
    match /assessmentAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAnyAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAnyAdmin());
      allow delete: if isPlatformOwner();
    }

    // Assessment Results (Controlled Release)
    match /assessmentResults/{resultId} {
      allow read: if isAuthenticated() && 
        ((resource.data.uid == request.auth.uid && resource.data.isReleased == true) || isAnyAdmin());
      allow create: if isAnyAdmin() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update: if isAnyAdmin();
      allow delete: if isPlatformOwner();
    }

    // -------------------------------------------------------------------------
    // Audit Logs (Immutable)
    // -------------------------------------------------------------------------

    match /auditLogs/{logId} {
      allow read: if isAnyAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

  }
}
