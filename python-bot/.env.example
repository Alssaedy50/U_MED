# ============================================================================
# U_MED Automated Telegram-to-Google-Drive & Firestore Draft Ingestion Engine
# Copy to .env for local testing or configure as Secrets in Hugging Face Spaces
# ============================================================================

# 1. Telegram MTProto API Credentials (https://my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# 2. Dual Telegram Clients (UserBot Group Listener + Bot Admin Notifier)
# Pyrogram UserBot Session String (Approved member of the student batch group; no admin rights needed)
SESSION_STRING=BQAA...your_pyrogram_mtproto_session_string
# Telegram Bot Token from @BotFather (Used to send instant draft alerts to ADMIN_TELEGRAM_ID)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 3. Target Student Batch Group & Admin Notification Recipient
# Negative supergroup/chat ID of the student batch group (e.g. -1001987654321)
TARGET_GROUP_ID=-1001987654321
# Personal Telegram User ID of the U_MED Admin receiving instant draft alerts
ADMIN_TELEGRAM_ID=123456789

# 4. Google Drive Resumable Upload Configuration
GDRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J_folder_id
GDRIVE_CREDENTIALS_B64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogInVtZWQteWVtZW4ifQ==
GDRIVE_PUBLIC_LINK=true

# 5. Firebase Admin / Cloud Firestore Credentials (U_MED Platform)
# Base64-encoded Firebase Service Account JSON (falls back to GDRIVE_CREDENTIALS_B64 if omitted)
FIREBASE_CREDENTIALS_B64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogInVtZWQteWVtZW4ifQ==
DEFAULT_UNIVERSITY_ID=univ-dar-al-salam
DEFAULT_PROGRAM_ID=medicine
DEFAULT_CURRICULUM_VERSION_ID=v2026

# 6. Transfer Tuning & 24/7 Container Health Check Server
UPLOAD_CHUNK_SIZE_MB=20
PORT=7860
